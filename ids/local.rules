#regula 1 test
alert tcp any any -> any any (msg:"CUSTOM - Posibila scanare Nmap (TCP SYN Scan)"; flags:S; threshold: type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

#regula 2 test nmap
alert tcp any any -> any any (msg:"CUSTOM ALERT - Detectie Scanare Porturi"; flags:S; threshold: type both, track by_src, count 2, seconds 1; classtype:attempted-recon; sid:1000002; rev:1;)

#regula 3 test hydra
alert tcp any any -> any 22 (msg:"CUSTOM ALERT - Atac Brute Force SSH Detectat"; flow:to_server,established; detection_filter:track by_src, count 5, seconds 1; classtype:attempted-admin; sid:1000003; rev:1;)

#regula 4 absoluta
alert tcp any any -> any any (msg:"CUSTOM TEST - Pachet SYN interceptat (Nmap)"; flags:S; classtype:attempted-recon; sid:1000067; rev:2;)
